// Modelar o banco é parte do desafio — por isso este arquivo só tem a
// configuração, sem nenhum model. Pense no que você precisa persistir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reservation {
  id             String   @id @default(uuid())
  quoteId        String
  passengerName  String
  idempotencyKey String   @unique
  status         String   @default("confirmed")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("reservations")
}
